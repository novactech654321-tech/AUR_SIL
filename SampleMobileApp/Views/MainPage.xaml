<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SampleMobileApp.ViewModels"
             xmlns:models="clr-namespace:SampleMobileApp.Models"
             x:Class="SampleMobileApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="My Tasks">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Placeholder="Add a task..."
                   Text="{Binding NewTitle}"
                   ReturnCommand="{Binding AddCommand}" />
            <Button Grid.Column="1" Text="Add" Command="{Binding AddCommand}" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}">
            <CollectionView.EmptyView>
                <Label Text="No tasks yet." HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,8" ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding IsDone}" Color="{StaticResource Primary}" />
                        <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" FontSize="16">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Button Grid.Column="2" Text="Delete"
                                BackgroundColor="{StaticResource Danger}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=DeleteCommand, x:DataType=vm:MainViewModel}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate> 
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
